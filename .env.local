# Redis (ElastiCache) - for ephemeral data (carts, reservations, inventory counters)
# Replace with your ElastiCache Redis endpoint
REDIS_URL=flashdrop-dev-redis.yhhwe0.0001.use1.cache.amazonaws.com:6379
REDIS_PASSWORD=

# PostgreSQL (RDS) - for persistent data (orders, payment transactions, audit logs)
# Replace with your RDS PostgreSQL endpoint
# Format: postgres://username:password@host:port/database?sslmode=require
POSTGRES_URL=postgres://flashdropadmin:FlashDrop2024Secure@flashdrop-dev-postgres.cw9sqcgrwzrr.us-east-1.rds.amazonaws.com:5432/flashdrop?sslmode=require

